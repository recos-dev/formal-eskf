<?xml version="1.0" encoding="UTF-8"?>
<project version="1">
    <root name=".."/>
    <importproject>../build/cppcheck/compile_commands.json</importproject>
    <analyze-all-vs-configs>false</analyze-all-vs-configs>
    <check-headers>true</check-headers>
    <check-unused-templates>false</check-unused-templates>
    <check-level-exhaustive>true</check-level-exhaustive>
    <max-ctu-depth>4</max-ctu-depth>
    <safe-checks>
        <class-public/>
        <external-functions/>
        <external-variables/>
    </safe-checks>
    <addons>
        <addon>misc</addon>
        <addon>threadsafety</addon>
    </addons>
</project>

+      // Clang represents the remaining elements of an aggregate-initialized
+      // array with one filler expression. In C++ it may run a default
+      // constructor or member initializer, so zero-filling is not equivalent.
+      // Convert it separately for each element to retain distinct constructor
+      // calls and their side effects.
+      if (t.is_array() && init_stmt.hasArrayFiller())
+      {
+        while (flat_inits.size() < inits.operands().size())
+        {
+          exprt filler;
+          if (get_expr(*init_stmt.getArrayFiller(), filler))
+            return true;
+          flat_inits.push_back(std::move(filler));
+        }
+      }
+
+      // Finish evaluating each array element before evaluating the next.
+      // Otherwise side-effect removal can leave earlier elements referring to
+      // a variable subsequently changed by a later initializer (e.g. ++count).
+      if (t.is_array() && mode == "C++")
+      {

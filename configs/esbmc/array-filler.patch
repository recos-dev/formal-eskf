+        {
+          if (init.statement() == "temporary_object")
+            continue;
+          side_effect_exprt temporary("temporary_object", init.type());
+          temporary.location() = init.location();
+          temporary.move_to_operands(init);
+          init.swap(temporary);
+        }
+      }
+
       unsigned int num = static_cast<unsigned>(flat_inits.size());
       for (unsigned int i = 0, j = 0; (i < inits.operands().size() && j < num);

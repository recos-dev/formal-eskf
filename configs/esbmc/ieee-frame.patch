@@ -68,6 +68,20 @@ inline int do_type_lt(const T &side1, const T &side2)

 // Explicit overloads for the field types whose semantics differ.

+// Expression identity is representation identity, not IEEE numeric equality.
+// In particular, +0 and -0 are distinct constants, and a NaN constant is
+// identical to itself. The enclosing node compares its type first; packed
+// bits also match the existing constant-float hash.
+inline bool do_type_cmp(const ieee_floatt &side1, const ieee_floatt &side2)
+{
+  return side1.pack() == side2.pack();
+}
+
+inline int do_type_lt(const ieee_floatt &side1, const ieee_floatt &side2)
+{
+  return side1.pack().compare(side2.pack());
+}

diff --git a/ROMFS/px4fmu_common/init.d-posix/rcS b/ROMFS/px4fmu_common/init.d-posix/rcS
index fed292b..51e7c86 100644
--- a/ROMFS/px4fmu_common/init.d-posix/rcS
+++ b/ROMFS/px4fmu_common/init.d-posix/rcS
@@ -264,7 +264,15 @@ commander start
 
 #
 # state estimator selection
-if param compare -s EKF2_EN 1
+if param compare -s FESKF_EN 1
+then
+	# Single owner of vehicle estimates; EKF2 is not started in this branch.
+	param set SENS_IMU_MODE 1
+	if param compare -s EKF2_EN 1; then param set EKF2_EN 0; fi
+	if param compare -s LPE_EN 1; then param set LPE_EN 0; fi
+	if param compare -s ATT_EN 1; then param set ATT_EN 0; fi
+	formal_eskf start
+elif param compare -s EKF2_EN 1
 then
 	ekf2 start &
 fi
@@ -354,7 +362,11 @@ fi
 [ -e "$autostart_file".post ] && . "$autostart_file".post
 
 # Run script to start logging
-if param compare -s EKF2_EN 1
+if param compare -s FESKF_EN 1
+then
+	# SIH lockstep logger must progress while the estimator is aligning.
+	set LOGGER_ARGS "-p vehicle_imu"
+elif param compare -s EKF2_EN 1
 then
 	set LOGGER_ARGS "-p ekf2_timestamps"
 else

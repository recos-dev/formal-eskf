# Verify permissions reach real replay corrections, including legacy CSV input.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef RUN_ID)
set(ROOT "${OUTPUT_DIR}/replay-bias-${CASE}-${RUN_ID}")
set(INPUT "${ROOT}/input")
set(OUTPUT "${ROOT}/result")
file(MAKE_DIRECTORY "${INPUT}")
file(WRITE "${INPUT}/initial.csv"
    "timestamp_us,q0,q1,q2,q3,vn,ve,vd,eph,epv,speed_accuracy\n1000000,1,0,0,0,0,0,0,1,1,0.2\n")
file(WRITE "${INPUT}/imu.csv" "timestamp_us,integral_dt_us,fx,fy,fz,wx,wy,wz\n")
if(NOT CASE STREQUAL "missing")
    file(WRITE "${INPUT}/imu_flags.csv" "timestamp_us,at_rest,accelerometer_clipping\n")
endif()
if(CASE STREQUAL "disabled")
    file(WRITE "${INPUT}/bias_parameters.csv"
        "maximum_specific_force,maximum_angular_rate,decay_time_constant,accelerometer_enabled,gyroscope_enabled\n25,3,0.5,0,0\n")
endif()
foreach(TIME RANGE 1000000 6000000 10000)
    set(PERIOD 10000)
    if(CASE STREQUAL "gap" AND TIME EQUAL 1010000)
        set(PERIOD 5000)
    endif()
    file(APPEND "${INPUT}/imu.csv" "${TIME},${PERIOD},0.2,-0.1,-9.70665,0.005,0.003,0.01\n")
    if(CASE STREQUAL "clipped")
        file(APPEND "${INPUT}/imu_flags.csv" "${TIME},1,7\n")
    elseif(NOT CASE STREQUAL "missing")
        file(APPEND "${INPUT}/imu_flags.csv" "${TIME},1,0\n")
    endif()
endforeach()
file(WRITE "${INPUT}/navigation.csv" "timestamp_us,pn,pe,pd,vn,ve,vd,eph,epv,speed_accuracy\n")
foreach(TIME RANGE 1200000 6000000 200000)
    file(APPEND "${INPUT}/navigation.csv" "${TIME},0,0,0,0,0,0,1,1,0.2\n")
endforeach()
execute_process(COMMAND "${REPLAY}" "${INPUT}" "${OUTPUT}"
    RESULT_VARIABLE RESULT OUTPUT_QUIET ERROR_VARIABLE STDERR TIMEOUT 30)
if(NOT RESULT STREQUAL "0")
    message(FATAL_ERROR "Bias replay failed: ${RESULT}\n${STDERR}\n${ROOT}")
endif()
file(READ "${OUTPUT}/summary.json" SUMMARY)
set(ACCEL_ENABLED TRUE)
set(GYRO_ENABLED TRUE)
if(CASE STREQUAL "clipped" OR CASE STREQUAL "disabled")
    set(ACCEL_ENABLED FALSE)
endif()
if(CASE STREQUAL "disabled")
    set(GYRO_ENABLED FALSE)
endif()
string(JSON ASSUMED GET "${SUMMARY}" bias_clipping_assumed_clear_samples)
string(JSON ACCEL_CORRECTIONS GET "${SUMMARY}" accelerometer_corrections)
if(CASE STREQUAL "missing")
    if(NOT ASSUMED EQUAL 500 OR NOT ACCEL_CORRECTIONS EQUAL 0)
        message(FATAL_ERROR "Missing clipping must be reported, and must still block gravity fusion: ${ROOT}")
    endif()
elseif(NOT ASSUMED EQUAL 0)
    message(FATAL_ERROR "Known clipping must not use compatibility assumptions: ${ROOT}")
endif()
foreach(AXIS RANGE 0 2)
    string(JSON ACCEL GET "${SUMMARY}" accelerometer_bias_learning_samples ${AXIS})
    string(JSON GYRO GET "${SUMMARY}" gyroscope_bias_learning_samples ${AXIS})
    if((ACCEL_ENABLED AND NOT ACCEL EQUAL 500) OR (NOT ACCEL_ENABLED AND NOT ACCEL EQUAL 0) OR
       (GYRO_ENABLED AND NOT GYRO EQUAL 500) OR (NOT GYRO_ENABLED AND NOT GYRO EQUAL 0))
        message(FATAL_ERROR "Expected immediate configuration/clipping permissions, with no startup delay: ${ROOT}")
    endif()
endforeach()
string(JSON PREDICTIONS GET "${SUMMARY}" covariance_predictions)
if(CASE STREQUAL "gap")
    if(NOT PREDICTIONS EQUAL 501)
        message(FATAL_ERROR "Gap hold must also use covariance prediction policy: ${ROOT}")
    endif()
elseif(NOT PREDICTIONS EQUAL 500)
    message(FATAL_ERROR "Unexpected covariance prediction count: ${ROOT}")
endif()
foreach(AXIS RANGE 0 2)
    string(JSON HELD GET "${SUMMARY}" gyroscope_bias_process_noise_inhibited_predictions ${AXIS})
    if(HELD LESS 1 OR HELD GREATER PREDICTIONS)
        message(FATAL_ERROR "Initial gyro bias variance must inhibit its noise: ${ROOT}")
    endif()
    if(CASE STREQUAL "disabled")
        string(JSON ACCEL_HELD GET "${SUMMARY}" accelerometer_bias_process_noise_inhibited_predictions ${AXIS})
        if(NOT HELD EQUAL 500 OR NOT ACCEL_HELD EQUAL 0)
            message(FATAL_ERROR "Learning disabled must not inhibit below-threshold accel process noise: ${ROOT}")
        endif()
    endif()
endforeach()
file(STRINGS "${OUTPUT}/state.csv" STATES REGEX "^[0-9]")
foreach(ROW IN LISTS STATES)
    string(REPLACE "," ";" VALUES "${ROW}")
    foreach(AXIS RANGE 0 2)
        math(EXPR INDEX "11 + ${AXIS}")
        list(GET VALUES ${INDEX} BIAS)
        if(NOT ACCEL_ENABLED AND NOT BIAS STREQUAL "0")
            message(FATAL_ERROR "Correction changed inhibited accel bias: ${ROOT}")
        endif()
        math(EXPR INDEX "14 + ${AXIS}")
        list(GET VALUES ${INDEX} BIAS)
        if(NOT GYRO_ENABLED AND NOT BIAS STREQUAL "0")
            message(FATAL_ERROR "Correction changed inhibited gyro bias: ${ROOT}")
        endif()
    endforeach()
endforeach()
list(GET STATES -1 LAST)
string(REPLACE "," ";" VALUES "${LAST}")
list(GET VALUES 11 BAX)
list(GET VALUES 14 BGX)
if((ACCEL_ENABLED AND BAX STREQUAL "0") OR (GYRO_ENABLED AND BGX STREQUAL "0"))
    message(FATAL_ERROR "Qualified bias must actually learn under nonzero IMU error: ${ROOT}")
endif()
message(STATUS "Bias replay ${CASE}: pass (${ROOT})")

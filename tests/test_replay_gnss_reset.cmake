# End-to-end reset orchestration through the real replay executable.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef RUN_ID)
set(ROOT "${OUTPUT_DIR}/replay-gnss-reset-${CASE}-${RUN_ID}")
set(INPUT "${ROOT}/input")
set(OUTPUT "${ROOT}/result")
file(MAKE_DIRECTORY "${INPUT}")
file(WRITE "${INPUT}/initial.csv"
    "timestamp_us,q0,q1,q2,q3,vn,ve,vd,eph,epv,speed_accuracy\n1000000,1,0,0,0,0,0,0,1,1,0.2\n")
file(WRITE "${INPUT}/gnss_parameters.csv"
    "position_gate,velocity_gate,position_noise,velocity_noise,position_noise_limit\n5,5,0.5,0.3,10\n")
file(WRITE "${INPUT}/gnss_quality_parameters.csv"
    "check_mask,minimum_satellites,maximum_pdop,maximum_horizontal_accuracy,maximum_vertical_accuracy,maximum_speed_accuracy,maximum_horizontal_drift,maximum_vertical_drift,minimum_health_time_us\n0,6,2.5,3,5,0.5,0.1,0.2,2000000\n")
file(WRITE "${INPUT}/imu.csv" "timestamp_us,integral_dt_us,fx,fy,fz,wx,wy,wz\n")
foreach(TIME RANGE 1000000 22000000 10000)
    file(APPEND "${INPUT}/imu.csv" "${TIME},10000,0,0,-9.80665,0,0,0\n")
endforeach()
file(WRITE "${INPUT}/navigation.csv" "timestamp_us,pn,pe,pd,vn,ve,vd,eph,epv,speed_accuracy\n")
file(WRITE "${INPUT}/gnss_quality.csv"
    "timestamp_us,fix_type,satellites,pdop,spoofed,vel_ned_valid,in_air,at_rest,vn,ve,vd,dn,de,dd,reference_timestamp_us\n")
foreach(TIME RANGE 1200000 22000000 200000)
    set(POSITION 15)
    set(HEIGHT 7) # Local NED Down, distinct from the zero seed.
    set(VELOCITY 0)
    set(VELOCITY_D 0)
    if(CASE STREQUAL "reset_failure" AND TIME EQUAL 3400000)
        set(VELOCITY nan) # Fault in the numerical observation, after valid quality metadata.
    elseif(CASE STREQUAL "position_reset_failure" AND TIME EQUAL 3400000)
        set(POSITION nan)
    elseif(CASE STREQUAL "height_reset_failure" AND TIME EQUAL 3400000)
        set(HEIGHT nan)
    elseif(CASE STREQUAL "height_reentry" AND TIME GREATER_EQUAL 5000000 AND TIME LESS 6200000)
        continue() # Height stops at 5.8 s; horizontal groups remain active.
    elseif(CASE STREQUAL "full_outage" AND TIME GREATER_EQUAL 5000000 AND TIME LESS 12200000)
        continue() # All groups stop; receipt alone cannot bypass recovery health time.
    elseif(TIME GREATER_EQUAL 5000000)
        if(CASE STREQUAL "both_timeout" OR CASE STREQUAL "all_timeout")
            set(VELOCITY 100)
            math(EXPR POSITION "1015 + (${TIME} - 5000000) / 10000")
            if(CASE STREQUAL "all_timeout")
                set(HEIGHT -993)
            endif()
        elseif(CASE STREQUAL "position_timeout")
            set(POSITION 1015)
        elseif(CASE STREQUAL "height_timeout" OR CASE STREQUAL "height_overdue_success")
            if(CASE STREQUAL "height_timeout" OR TIME LESS 10000000)
                set(HEIGHT -993)
            endif()
        elseif(CASE STREQUAL "vertical_velocity_reset")
            set(VELOCITY_D 100)
            set(HEIGHT -993)
            if(TIME GREATER 10000000)
                math(EXPR HEIGHT "-993 + (${TIME} - 10000000) / 10000")
            endif()
        elseif(CASE STREQUAL "height_reentry" OR CASE STREQUAL "full_outage")
            set(HEIGHT 17)
        endif()
    endif()
    file(APPEND "${INPUT}/navigation.csv" "${TIME},${POSITION},0,${HEIGHT},${VELOCITY},0,${VELOCITY_D},1,1,0.2\n")
    set(QUALITY_VELOCITY "${VELOCITY}")
    if(CASE STREQUAL "reset_failure")
        set(QUALITY_VELOCITY 0)
    endif()
    file(APPEND "${INPUT}/gnss_quality.csv" "${TIME},3,10,1,0,1,1,-1,${QUALITY_VELOCITY},0,${VELOCITY_D},0,0,0,0\n")
endforeach()

execute_process(COMMAND "${REPLAY}" "${INPUT}" "${OUTPUT}"
    RESULT_VARIABLE RESULT OUTPUT_QUIET ERROR_VARIABLE STDERR TIMEOUT 60)
if(CASE STREQUAL "reset_failure" OR CASE STREQUAL "position_reset_failure" OR CASE STREQUAL "height_reset_failure")
    if(NOT RESULT STREQUAL "1" OR EXISTS "${OUTPUT}/summary.json")
        message(FATAL_ERROR "Expected failure without success summary: ${RESULT}\n${STDERR}\n${ROOT}")
    endif()
    set(COMPLETED_GROUPS)
    if(CASE STREQUAL "reset_failure")
        set(GROUP velocity)
        set(AXES 3)
    elseif(CASE STREQUAL "position_reset_failure")
        set(GROUP horizontal_position)
        set(AXES 2)
        set(COMPLETED_GROUPS velocity)
    else()
        set(GROUP vertical_position)
        set(AXES 1)
        set(COMPLETED_GROUPS velocity horizontal_position)
    endif()
    foreach(COMPLETED_GROUP IN LISTS COMPLETED_GROUPS)
        file(STRINGS "${OUTPUT}/gnss_lifecycle.csv" COMPLETED REGEX "^3400000,3400000,${COMPLETED_GROUP},1,none,0,3400000,0,0,3400000$")
        if(NOT COMPLETED)
            message(FATAL_ERROR "Later reset failure must retain completed ${COMPLETED_GROUP} reset: ${ROOT}")
        endif()
    endforeach()
    file(STRINGS "${OUTPUT}/gnss_resets.csv" ROWS REGEX "^3400000,3400000,${GROUP},[0-2],initialization_required,failed,1,0,$")
    list(LENGTH ROWS COUNT)
    if(NOT COUNT EQUAL AXES)
        message(FATAL_ERROR "Reset failure must log ${AXES} invalid deltas: ${ROOT}\n${STDERR}")
    endif()
    file(STRINGS "${OUTPUT}/gnss_lifecycle.csv" ROWS REGEX "^3400000,3400000,${GROUP},0,reset_failed,1,0,0,0,0$")
    file(STRINGS "${OUTPUT}/gnss_updates.csv" FUSIONS REGEX "^[0-9]")
    if(NOT ROWS OR FUSIONS)
        message(FATAL_ERROR "Failed reset fabricated progress or allowed correction: ${ROOT}")
    endif()
    return()
endif()
if(NOT RESULT STREQUAL "0")
    message(FATAL_ERROR "Replay failed: ${RESULT}\n${STDERR}\n${ROOT}")
endif()

set(RESET_TIMES 3400000)
set(RESET_COUNT 1)
set(HEIGHT_TIMES 3400000)
set(HEIGHT_COUNT 1)
set(VERTICAL_VELOCITY_COUNT 0)
if(CASE STREQUAL "height_timeout" OR CASE STREQUAL "height_overdue_success" OR CASE STREQUAL "all_timeout" OR CASE STREQUAL "vertical_velocity_reset")
    set(VERTICAL_VELOCITY_COUNT 1)
endif()
if(CASE STREQUAL "both_timeout" OR CASE STREQUAL "all_timeout")
    list(APPEND RESET_TIMES 12000000)
    set(RESET_COUNT 2)
    if(CASE STREQUAL "all_timeout")
        list(APPEND HEIGHT_TIMES 10000000)
        set(HEIGHT_COUNT 2)
    endif()
elseif(CASE STREQUAL "position_timeout")
    list(APPEND RESET_TIMES 19000000)
    set(RESET_COUNT 2)
elseif(CASE STREQUAL "full_outage")
    list(APPEND RESET_TIMES 13400000)
    list(APPEND HEIGHT_TIMES 13400000)
    set(RESET_COUNT 2)
    set(HEIGHT_COUNT 2)
elseif(CASE STREQUAL "height_reentry")
    list(APPEND HEIGHT_TIMES 6200000)
    set(HEIGHT_COUNT 2)
elseif(CASE STREQUAL "height_timeout" OR CASE STREQUAL "vertical_velocity_reset")
    list(APPEND HEIGHT_TIMES 10000000)
    set(HEIGHT_COUNT 2)
elseif(NOT CASE STREQUAL "startup" AND NOT CASE STREQUAL "height_overdue_success")
    message(FATAL_ERROR "Unknown reset test case: ${CASE}")
endif()
foreach(TIME IN LISTS RESET_TIMES)
    set(START 3400000)
    if(TIME EQUAL 13400000)
        set(START ${TIME})
    endif()
    if(TIME EQUAL 3400000 OR TIME EQUAL 13400000)
        set(REASON initialization_required)
    else()
        set(REASON fusion_timeout)
    endif()
    file(STRINGS "${OUTPUT}/gnss_resets.csv" ROWS REGEX "^${TIME},${TIME},(velocity|horizontal_position),[0-2],${REASON},reset,0,1,")
    list(LENGTH ROWS COUNT)
    if(NOT COUNT EQUAL 5)
        message(FATAL_ERROR "Expected both resets at ${TIME}, got ${COUNT} axis rows: ${ROOT}")
    endif()
    list(GET ROWS 0 FIRST)
    list(GET ROWS 3 FOURTH)
    if(NOT FIRST MATCHES ",velocity,0," OR NOT FOURTH MATCHES ",horizontal_position,0,")
        message(FATAL_ERROR "Reset order must be velocity then position: ${ROOT}")
    endif()
    file(STRINGS "${OUTPUT}/gnss_updates.csv" ROWS REGEX "^${TIME},${TIME},(velocity|horizontal_position),")
    if(ROWS)
        message(FATAL_ERROR "Reset must replace, not precede, this sample's correction: ${ROOT}")
    endif()
    file(STRINGS "${OUTPUT}/gnss_lifecycle.csv" ROWS REGEX "^${TIME},${TIME},(velocity|horizontal_position),1,none,0,${START},[0-9]+,0,${TIME}$")
    list(LENGTH ROWS COUNT)
    if(NOT COUNT EQUAL 2)
        message(FATAL_ERROR "Reset must refresh progress without restarting session/quality: ${ROOT}")
    endif()
    math(EXPR NEXT "${TIME} + 200000")
    file(STRINGS "${OUTPUT}/gnss_updates.csv" ROWS REGEX "^${NEXT},${NEXT},(velocity|horizontal_position),[0-2],fused,")
    list(LENGTH ROWS COUNT)
    if(NOT COUNT EQUAL 5)
        message(FATAL_ERROR "Next accepted sample must resume actual corrections: ${ROOT}")
    endif()
endforeach()
foreach(TIME IN LISTS HEIGHT_TIMES)
    set(REASON initialization_required)
    set(START ${TIME})
    set(LAST_FUSE 4800000)
    set(DELTA 10)
    set(HEIGHT 17)
    set(VELOCITY_D 0)
    if(TIME EQUAL 3400000)
        set(LAST_FUSE 0)
        set(DELTA 7)
        set(HEIGHT 7)
    elseif(TIME EQUAL 10000000)
        set(REASON fusion_timeout)
        set(START 3400000)
        set(DELTA -1000)
        set(HEIGHT -993)
        if(CASE STREQUAL "vertical_velocity_reset")
            set(VELOCITY_D 100)
        endif()
    endif()
    file(STRINGS "${OUTPUT}/gnss_resets.csv" ROWS REGEX "^${TIME},${TIME},vertical_position,0,${REASON},reset,0,1,${DELTA}$")
    file(STRINGS "${OUTPUT}/gnss_lifecycle.csv" PROGRESS REGEX "^${TIME},${TIME},vertical_position,1,none,0,${START},${LAST_FUSE},0,${TIME}$")
    if(NOT ROWS OR NOT PROGRESS)
        message(FATAL_ERROR "Height reset delta, progress or session is incorrect: ${ROOT}")
    endif()
    file(STRINGS "${OUTPUT}/gnss_updates.csv" FUSIONS REGEX "^${TIME},${TIME},vertical_position,")
    if(TIME EQUAL 10000000)
        if(NOT FUSIONS MATCHES ",rejected,")
            message(FATAL_ERROR "Height timeout must attempt correction before resetting: ${ROOT}")
        endif()
    elseif(FUSIONS)
        message(FATAL_ERROR "Height startup/re-entry must reset without correction: ${ROOT}")
    endif()
    file(STRINGS "${OUTPUT}/state.csv" ROWS REGEX "^${TIME},15,0,${HEIGHT},0,0,${VELOCITY_D},1,0,0,0,")
    if(NOT ROWS)
        message(FATAL_ERROR "Height reset must replace Down without changing other nominal fields: ${ROOT}")
    endif()
    list(GET ROWS 0 STATE)
    string(REPLACE "," ";" STATE "${STATE}")
    list(GET STATE 19 VARIANCE) # P_DD uses prepared vertical observation variance.
    if(NOT VARIANCE EQUAL 1)
        message(FATAL_ERROR "Height reset covariance did not use prepared noise: ${ROOT}")
    endif()
    math(EXPR NEXT "${TIME} + 200000")
    file(STRINGS "${OUTPUT}/gnss_updates.csv" ROWS REGEX "^${NEXT},${NEXT},vertical_position,0,fused,")
    if(NOT ROWS)
        message(FATAL_ERROR "Height corrections must resume on the next accepted sample: ${ROOT}")
    endif()
endforeach()
if(VERTICAL_VELOCITY_COUNT EQUAL 1)
    file(STRINGS "${OUTPUT}/gnss_updates.csv" ROWS REGEX "^9800000,9800000,vertical_position,0,rejected,")
    file(STRINGS "${OUTPUT}/gnss_resets.csv" EARLY REGEX "^9800000,")
    if(NOT ROWS OR EARLY)
        message(FATAL_ERROR "Height deadline equality must not reset: ${ROOT}")
    endif()
    if(CASE STREQUAL "height_overdue_success")
        file(STRINGS "${OUTPUT}/gnss_updates.csv" ROWS REGEX "^10000000,10000000,vertical_position,0,fused,")
        if(NOT ROWS)
            message(FATAL_ERROR "Successful overdue correction must win over reset: ${ROOT}")
        endif()
    endif()
    set(DELTA 0)
    if(CASE STREQUAL "vertical_velocity_reset")
        set(DELTA 100)
    endif()
    file(STRINGS "${OUTPUT}/gnss_resets.csv" ROWS REGEX "^10000000,10000000,vertical_velocity,0,fusion_timeout,reset,0,1,${DELTA}$")
    if(NOT ROWS)
        message(FATAL_ERROR "Expected a Down velocity reset even when later height correction succeeds: ${ROOT}")
    endif()
    if(CASE STREQUAL "vertical_velocity_reset" OR CASE STREQUAL "all_timeout")
        file(STRINGS "${OUTPUT}/gnss_lifecycle.csv" ROWS REGEX "^10000000,10000000,velocity,1,none,0,3400000,4800000,0,3400000$")
        file(STRINGS "${OUTPUT}/gnss_updates.csv" REJECTED REGEX "^10000000,10000000,velocity,2,rejected,")
        if(NOT ROWS OR NOT REJECTED)
            message(FATAL_ERROR "Down-only reset must not fabricate 3D velocity fusion/reset progress: ${ROOT}")
        endif()
    endif()
    if(NOT CASE STREQUAL "height_overdue_success")
        file(STRINGS "${OUTPUT}/gnss_resets.csv" ROWS REGEX "^10000000,")
        list(GET ROWS 0 FIRST)
        list(GET ROWS 1 SECOND)
        if(NOT FIRST MATCHES ",vertical_velocity," OR NOT SECOND MATCHES ",vertical_position,")
            message(FATAL_ERROR "Down velocity reset must precede height reset: ${ROOT}")
        endif()
        file(STRINGS "${OUTPUT}/state.csv" ROWS REGEX "^10000000,")
        list(GET ROWS 0 STATE)
        string(REPLACE "," ";" STATE "${STATE}")
        list(GET STATE 22 VARIANCE) # P_vD,vD: prepared vertical std = 1.5 * 0.3.
        if(VARIANCE LESS 0.20249999 OR VARIANCE GREATER 0.20250001)
            message(FATAL_ERROR "Down reset must use prepared variance without scaling again: ${ROOT}")
        endif()
    endif()
endif()
if(CASE STREQUAL "all_timeout")
    file(STRINGS "${OUTPUT}/fusion_conditions.csv" ROWS REGEX "^11800000,[^,]+,[01],0,")
    if(NOT ROWS)
        message(FATAL_ERROR "Height reset must not renew horizontal-aiding time: ${ROOT}")
    endif()
endif()
if(CASE STREQUAL "height_reentry" OR CASE STREQUAL "full_outage")
    file(STRINGS "${OUTPUT}/gnss_lifecycle.csv" ROWS REGEX "^0,5800000,vertical_position,0,data_timeout,0,")
    if(NOT ROWS)
        message(FATAL_ERROR "Missing height data must stop height at its own deadline: ${ROOT}")
    endif()
    if(CASE STREQUAL "full_outage")
        file(STRINGS "${OUTPUT}/gnss_lifecycle.csv" ROWS REGEX "^0,11800000,velocity,0,data_timeout,0,3400000,4800000,1,3400000$")
        file(STRINGS "${OUTPUT}/gnss_resets.csv" EARLY REGEX "^12[0-9]+,")
        file(STRINGS "${OUTPUT}/gnss_updates.csv" FUSIONS REGEX "^12[0-9]+,")
        if(NOT ROWS OR EARLY OR FUSIONS)
            message(FATAL_ERROR "Full outage must restart quality hold before allowing any recovery: ${ROOT}")
        endif()
    endif()
endif()
file(STRINGS "${OUTPUT}/state.csv" ROWS REGEX "^3400000,15,0,7,0,0,0,1,0,0,0,")
if(NOT ROWS)
    message(FATAL_ERROR "Startup must actually replace position, not merely acknowledge reset: ${ROOT}")
endif()
list(GET ROWS 0 STATE)
string(REPLACE "," ";" STATE "${STATE}")
foreach(INDEX IN ITEMS 17 18) # P_NN and P_EE: sum of the two input variances.
    list(GET STATE ${INDEX} VARIANCE)
    if(NOT VARIANCE EQUAL 2)
        message(FATAL_ERROR "Horizontal reset covariance did not use the variance sum: ${ROOT}")
    endif()
endforeach()
foreach(INDEX IN ITEMS 20 21) # Horizontal velocity: 0.3 m/s floor, squared.
    list(GET STATE ${INDEX} VARIANCE)
    if(VARIANCE LESS 0.08999999 OR VARIANCE GREATER 0.09000001)
        message(FATAL_ERROR "Velocity reset covariance did not use prepared noise: ${ROOT}")
    endif()
endforeach()
file(STRINGS "${OUTPUT}/gnss_resets.csv" ROWS REGEX "^[0-9]")
list(LENGTH ROWS COUNT)
math(EXPR EXPECTED "5 * ${RESET_COUNT} + ${HEIGHT_COUNT} + ${VERTICAL_VELOCITY_COUNT}")
if(NOT COUNT EQUAL EXPECTED)
    message(FATAL_ERROR "Unexpected/missing repeated resets: ${ROOT}")
endif()
file(READ "${OUTPUT}/summary.json" SUMMARY)
string(JSON RESETS GET "${SUMMARY}" vertical_velocity_resets)
if(NOT RESETS EQUAL VERTICAL_VELOCITY_COUNT)
    message(FATAL_ERROR "Unexpected/missing Down-only reset count: ${ROOT}")
endif()
string(JSON ACCEPTED GET "${SUMMARY}" gnss_quality_accepted)
foreach(GROUP IN ITEMS velocity horizontal_position vertical_position)
    string(JSON RESETS GET "${SUMMARY}" "${GROUP}_resets")
    string(JSON FUSED GET "${SUMMARY}" "${GROUP}_corrections")
    string(JSON REJECTED GET "${SUMMARY}" "${GROUP}_rejected")
    string(JSON SKIPPED GET "${SUMMARY}" "${GROUP}_lifecycle_skipped")
    math(EXPR ACCOUNTED "${RESETS} + ${FUSED} + ${REJECTED}")
    set(EXPECTED ${RESET_COUNT})
    if(GROUP STREQUAL "vertical_position")
        set(EXPECTED ${HEIGHT_COUNT})
        if(CASE STREQUAL "height_timeout" OR CASE STREQUAL "all_timeout" OR CASE STREQUAL "vertical_velocity_reset")
            math(EXPR ACCOUNTED "${ACCOUNTED} - 1") # One event rejects correction then resets.
        endif()
    endif()
    if(NOT RESETS EQUAL EXPECTED OR NOT ACCOUNTED EQUAL ACCEPTED OR NOT SKIPPED EQUAL 0)
        message(FATAL_ERROR "Reset/correction/rejection accounting is inconsistent for ${GROUP}: ${ROOT}")
    endif()
endforeach()

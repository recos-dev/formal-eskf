# Heading reset/recovery through actual replay field checks, gates and lifecycle.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef RUN_ID)
set(ROOT "${OUTPUT_DIR}/replay-mag-reset-${CASE}-${RUN_ID}")
set(INPUT "${ROOT}/input")
set(OUTPUT "${ROOT}/result")
file(MAKE_DIRECTORY "${INPUT}")
file(WRITE "${INPUT}/initial.csv"
    "timestamp_us,q0,q1,q2,q3,vn,ve,vd,eph,epv,speed_accuracy\n1000000,1,0,0,0,0,0,0,1,1,0.2\n")
file(WRITE "${INPUT}/imu.csv" "timestamp_us,integral_dt_us,fx,fy,fz,wx,wy,wz\n")
file(WRITE "${INPUT}/imu_flags.csv" "timestamp_us,at_rest,accelerometer_clipping\n")
foreach(TIME RANGE 1000000 45000000 10000)
    set(YAW_RATE 0)
    if(TIME LESS_EQUAL 17000000)
        # Two full yaw turns excite body-fixed bias versus navigation tilt.
        # Without excitation, stationary GNSS alone cannot separate them.
        set(YAW_RATE 0.7853981633974483)
    endif()
    file(APPEND "${INPUT}/imu.csv" "${TIME},10000,0,0,-9.80665,0,0,${YAW_RATE}\n")
    file(APPEND "${INPUT}/imu_flags.csv" "${TIME},0,0\n")
endforeach()
# Initial navigation aiding establishes tilt. Only the aided case keeps it.
file(WRITE "${INPUT}/navigation.csv" "timestamp_us,pn,pe,pd,vn,ve,vd,eph,epv,speed_accuracy\n")
foreach(TIME RANGE 1200000 45000000 200000)
    if(CASE STREQUAL "aided" OR TIME LESS 20000000 OR TIME EQUAL 45000000)
        file(APPEND "${INPUT}/navigation.csv" "${TIME},0,0,0,0,0,0,1,1,0.2\n")
    endif()
endforeach()
file(WRITE "${INPUT}/magnetic_reference.csv" "mn,me,md,noise_std,gate_sigma\n20,0,40,0.5,0.1\n")
file(WRITE "${INPUT}/magnetometer.csv" "timestamp_us,mx,my,mz\n")
foreach(TIME RANGE 18100000 45000000 100000)
    set(FIELD "20,0,40")
    if(TIME GREATER_EQUAL 30000000)
        set(FIELD "0,20,40") # Same strength/inclination; 90-degree heading discrepancy.
        if(CASE STREQUAL "disturbed" AND TIME LESS 40000000)
            set(FIELD "0,200,400") # Unhealthy magnitude must not authorize a reset.
        endif()
    endif()
    file(APPEND "${INPUT}/magnetometer.csv" "${TIME},${FIELD}\n")
endforeach()

execute_process(COMMAND "${REPLAY}" "${INPUT}" "${OUTPUT}"
    RESULT_VARIABLE RESULT OUTPUT_QUIET ERROR_VARIABLE STDERR TIMEOUT 60)
if(NOT RESULT STREQUAL "0")
    message(FATAL_ERROR "Replay failed: ${RESULT}\n${STDERR}\n${ROOT}")
endif()
file(STRINGS "${OUTPUT}/magnetometer_resets.csv" RESETS REGEX "^[0-9]")
list(LENGTH RESETS RESET_COUNT)
file(READ "${OUTPUT}/summary.json" SUMMARY)
string(JSON SUMMARY_RESETS GET "${SUMMARY}" magnetometer_heading_resets)
if(NOT SUMMARY_RESETS EQUAL RESET_COUNT)
    message(FATAL_ERROR "Reset summary disagrees with applied-reset log: ${ROOT}")
endif()
file(STRINGS "${OUTPUT}/magnetometer_updates.csv" FUSED REGEX "^[0-9]+,[0-9]+,fused,")
if(NOT FUSED)
    message(FATAL_ERROR "Fixture never started magnetic fusion: ${ROOT}")
endif()
if(CASE STREQUAL "aided")
    file(STRINGS "${OUTPUT}/magnetometer_updates.csv" STOPS REGEX ",fusion_timeout,none,")
    if(NOT RESET_COUNT EQUAL 0 OR NOT STOPS)
        message(FATAL_ERROR "Horizontal aiding must stop instead of resetting yaw: ${ROOT}")
    endif()
else()
    if(NOT RESET_COUNT EQUAL 1)
        message(FATAL_ERROR "Expected one applied heading reset, got ${RESET_COUNT}: ${ROOT}")
    endif()
    list(GET RESETS 0 RESET_ROW)
    string(REPLACE "," ";" FIELDS "${RESET_ROW}")
    list(GET FIELDS 0 RESET_TIME)
    list(GET FIELDS 2 STATUS)
    if(NOT STATUS EQUAL 0 OR RESET_TIME LESS_EQUAL 36900000)
        message(FATAL_ERROR "Reset must succeed strictly after 7 s without fusion: ${ROOT}")
    endif()
    if(CASE STREQUAL "disturbed" AND RESET_TIME LESS_EQUAL 40900000)
        message(FATAL_ERROR "Bad field must requalify >1 s health before reset: ${ROOT}")
    endif()
    file(STRINGS "${OUTPUT}/magnetometer_updates.csv" RESET_EVENTS REGEX "^${RESET_TIME},${RESET_TIME},reset,0,")
    if(NOT RESET_EVENTS)
        message(FATAL_ERROR "Applied reset must be visible as reset, not fused: ${ROOT}")
    endif()
    list(GET RESET_EVENTS 0 RESET_EVENT)
    if(NOT RESET_EVENT MATCHES ",29900000,${RESET_TIME}$")
        message(FATAL_ERROR "Reset must retain last actual fusion and record separate reset time: ${ROOT}")
    endif()
    set(RESUMED FALSE)
    foreach(ROW IN LISTS FUSED)
        string(REGEX MATCH "^[0-9]+" FUSED_TIME "${ROW}")
        if(FUSED_TIME GREATER RESET_TIME)
            set(RESUMED TRUE)
        endif()
    endforeach()
    if(NOT RESUMED)
        message(FATAL_ERROR "Real magnetic correction must resume after heading reset: ${ROOT}")
    endif()
endif()
message(STATUS "Magnetic recovery ${CASE}: pass (${ROOT})")

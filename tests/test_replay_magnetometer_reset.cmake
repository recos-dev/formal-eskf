# Heading reset/recovery through actual replay field checks, gates and lifecycle.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef RUN_ID)
set(ROOT "${OUTPUT_DIR}/replay-mag-reset-${CASE}-${RUN_ID}")
set(REINITIALIZE FALSE)
set(MODEL_CASE FALSE)
if(CASE MATCHES "^model_")
    set(MODEL_CASE TRUE)
endif()
if(CASE MATCHES "^(source_|reference_)" OR CASE STREQUAL "calibration" OR CASE STREQUAL "context_invalid")
    set(REINITIALIZE TRUE)
endif()
set(AIDED_CASES aided source_ground source_air source_unknown calibration source_disturbed reference_aided context_invalid)
if(MODEL_CASE)
    list(APPEND AIDED_CASES "${CASE}")
endif()
list(FIND AIDED_CASES "${CASE}" AIDED_INDEX)
set(INPUT "${ROOT}/input")
set(OUTPUT "${ROOT}/result")
file(MAKE_DIRECTORY "${INPUT}")
file(WRITE "${INPUT}/initial.csv"
    "timestamp_us,q0,q1,q2,q3,vn,ve,vd,eph,epv,speed_accuracy\n1000000,1,0,0,0,0,0,0,1,1,0.2\n")
file(WRITE "${INPUT}/imu.csv" "timestamp_us,integral_dt_us,fx,fy,fz,wx,wy,wz\n")
file(WRITE "${INPUT}/imu_flags.csv" "timestamp_us,at_rest,accelerometer_clipping\n")
foreach(TIME RANGE 1000000 45000000 10000)
    set(YAW_RATE 0)
    if(TIME LESS_EQUAL 17000000)
        # Two full yaw turns excite body-fixed bias versus navigation tilt.
        # Without excitation, stationary GNSS alone cannot separate them.
        set(YAW_RATE 0.7853981633974483)
    endif()
    file(APPEND "${INPUT}/imu.csv" "${TIME},10000,0,0,-9.80665,0,0,${YAW_RATE}\n")
    file(APPEND "${INPUT}/imu_flags.csv" "${TIME},0,0\n")
endforeach()
# Initial navigation aiding establishes tilt. Only the aided case keeps it.
file(WRITE "${INPUT}/navigation.csv" "timestamp_us,pn,pe,pd,vn,ve,vd,eph,epv,speed_accuracy\n")
if(MODEL_CASE)
    file(WRITE "${INPUT}/gnss_parameters.csv"
        "position_gate,velocity_gate,position_noise,velocity_noise,position_noise_limit\n5,5,1,0.2,1\n")
    file(WRITE "${INPUT}/magnetic_model.csv"
        "timestamp_us,available,declination_rad,inclination_rad,strength_ut\n1000000,1,0,1.1071487177940904,44.721359549995796\n")
endif()
foreach(TIME RANGE 1200000 45000000 200000)
    if(AIDED_INDEX GREATER_EQUAL 0 OR TIME LESS 20000000 OR TIME EQUAL 45000000)
        set(POSITION 0)
        if(MODEL_CASE)
            set(MODEL "1,0,1.1071487177940904,44.721359549995796")
            if(TIME GREATER_EQUAL 30000000)
                set(MODEL "1,1.5707963267948966,1.1071487177940904,44.721359549995796")
                if(CASE STREQUAL "model_rejected_position")
                    set(POSITION 1000000)
                elseif(CASE STREQUAL "model_unavailable")
                    set(MODEL "0,0,0,0")
                endif()
            endif()
            file(APPEND "${INPUT}/magnetic_model.csv" "${TIME},${MODEL}\n")
        endif()
        file(APPEND "${INPUT}/navigation.csv" "${TIME},${POSITION},0,0,0,0,0,1,1,0.2\n")
    endif()
endforeach()
file(WRITE "${INPUT}/magnetic_reference.csv" "mn,me,md,noise_std,gate_sigma\n20,0,40,0.5,0.1\n")
file(WRITE "${INPUT}/magnetometer.csv" "timestamp_us,mx,my,mz\n")
if(REINITIALIZE)
    file(WRITE "${INPUT}/magnetic_context.csv"
        "timestamp_us,device_id,calibration_count,reference_id,in_air,mn,me,md\n1000000,1,0,0,1,20,0,40\n")
endif()
foreach(TIME RANGE 18100000 45000000 100000)
    set(FIELD "20,0,40")
    if(TIME GREATER_EQUAL 30000000 AND NOT MODEL_CASE)
        set(FIELD "0,20,40") # Same strength/inclination; 90-degree heading discrepancy.
        if((CASE STREQUAL "disturbed" OR CASE STREQUAL "source_disturbed") AND TIME LESS 40000000)
            set(FIELD "0,200,400") # Unhealthy magnitude must not authorize a reset.
        endif()
    endif()
    if(REINITIALIZE)
        set(DEVICE 1)
        set(CALIBRATION 0)
        set(REFERENCE_ID 0)
        set(IN_AIR 1)
        set(REFERENCE "20,0,40")
        if(TIME GREATER_EQUAL 30000000)
            if(CASE MATCHES "^reference_" OR CASE STREQUAL "context_invalid")
                set(REFERENCE_ID 1)
                set(REFERENCE "0,20,40")
                set(FIELD "20,0,40")
                if(CASE STREQUAL "context_invalid")
                    set(REFERENCE_ID 0)
                endif()
            elseif(CASE STREQUAL "calibration")
                set(CALIBRATION 1)
                set(IN_AIR 0)
            else()
                set(DEVICE 2)
                if(CASE STREQUAL "source_ground" OR CASE STREQUAL "source_disturbed")
                    set(IN_AIR 0)
                elseif(CASE STREQUAL "source_unknown")
                    set(IN_AIR -1)
                elseif(CASE STREQUAL "source_air")
                    set(FIELD "20,0,40")
                endif()
            endif()
        endif()
        file(APPEND "${INPUT}/magnetic_context.csv" "${TIME},${DEVICE},${CALIBRATION},${REFERENCE_ID},${IN_AIR},${REFERENCE}\n")
    endif()
    file(APPEND "${INPUT}/magnetometer.csv" "${TIME},${FIELD}\n")
endforeach()

execute_process(COMMAND "${REPLAY}" "${INPUT}" "${OUTPUT}"
    RESULT_VARIABLE RESULT OUTPUT_QUIET ERROR_VARIABLE STDERR TIMEOUT 60)
if(CASE STREQUAL "context_invalid")
    if(RESULT STREQUAL "0" OR NOT STDERR MATCHES "changed magnetic reference requires a new revision")
        message(FATAL_ERROR "Unversioned reference change was not rejected: ${ROOT} ${STDERR}")
    endif()
    return()
endif()
if(NOT RESULT STREQUAL "0")
    message(FATAL_ERROR "Replay failed: ${RESULT}\n${STDERR}\n${ROOT}")
endif()
file(STRINGS "${OUTPUT}/magnetometer_resets.csv" RESETS REGEX "^[0-9]")
list(LENGTH RESETS RESET_COUNT)
file(READ "${OUTPUT}/summary.json" SUMMARY)
string(JSON SUMMARY_RESETS GET "${SUMMARY}" magnetometer_heading_resets)
if(NOT SUMMARY_RESETS EQUAL RESET_COUNT)
    message(FATAL_ERROR "Reset summary disagrees with applied-reset log: ${ROOT}")
endif()
file(STRINGS "${OUTPUT}/magnetometer_updates.csv" FUSED REGEX "^[0-9]+,[0-9]+,fused,")
if(NOT FUSED)
    message(FATAL_ERROR "Fixture never started magnetic fusion: ${ROOT}")
endif()
if(MODEL_CASE)
    string(JSON MODEL_CHECKS GET "${SUMMARY}" magnetic_model_checks)
    string(JSON MODEL_CHANGES GET "${SUMMARY}" magnetic_model_changes)
    if(MODEL_CHECKS LESS 3 OR NOT RESET_COUNT EQUAL 0)
        message(FATAL_ERROR "Expected periodic geographic checks without an aided heading reset: ${ROOT}")
    endif()
    file(STRINGS "${OUTPUT}/magnetic_reference_updates.csv" REFERENCE_ROWS REGEX "^[0-9]")
    if(CASE STREQUAL "model_aided")
        if(NOT MODEL_CHANGES EQUAL 2)
            message(FATAL_ERROR "Accepted changed geographic field was not adopted: ${ROOT}")
        endif()
        list(GET REFERENCE_ROWS -1 REFERENCE)
        if(NOT REFERENCE MATCHES "^[0-9]+,38300000,1,2,")
            message(FATAL_ERROR "Geographic reference must respect strict periodic check timing: ${ROOT}: ${REFERENCE}")
        endif()
        file(STRINGS "${OUTPUT}/magnetometer_updates.csv" INHIBITED REGEX ",heading_inconsistent,none,")
        if(NOT INHIBITED)
            message(FATAL_ERROR "Adopted geographic field never reached heading/fusion policy: ${ROOT}")
        endif()
    elseif(NOT MODEL_CHANGES EQUAL 1)
        message(FATAL_ERROR "Rejected position or unavailable model must retain the seed reference: ${ROOT}")
    endif()
    if(CASE STREQUAL "model_rejected_position")
        string(JSON POSITION_REJECTED GET "${SUMMARY}" horizontal_position_rejected)
        string(JSON VELOCITY_FUSED GET "${SUMMARY}" velocity_corrections)
        if(POSITION_REJECTED LESS 1 OR VELOCITY_FUSED LESS 200)
            message(FATAL_ERROR "Fixture must reject position while continuing velocity aiding: ${ROOT}")
        endif()
    endif()
    message(STATUS "Geographic magnetic replay ${CASE}: pass (${ROOT})")
    return()
endif()
if(REINITIALIZE)
    if(CASE STREQUAL "source_air" OR CASE STREQUAL "source_unknown" OR CASE STREQUAL "reference_aided")
        if(NOT RESET_COUNT EQUAL 0)
            message(FATAL_ERROR "Aided flight/unknown flight must not reset heading: ${ROOT}")
        endif()
        if(CASE STREQUAL "source_air")
            file(STRINGS "${OUTPUT}/magnetometer_updates.csv" RESUMED REGEX "^30300000,30300000,fused,")
            if(NOT RESUMED)
                message(FATAL_ERROR "Aided flight must re-enter real correction after four samples: ${ROOT}")
            endif()
        elseif(CASE STREQUAL "source_unknown")
            string(JSON REASON GET "${SUMMARY}" magnetometer_recovery_reason)
            if(NOT REASON STREQUAL "source_changed")
                message(FATAL_ERROR "Unknown flight state must leave reinitialization pending: ${ROOT}")
            endif()
        endif()
    else()
        if(NOT RESET_COUNT EQUAL 1)
            message(FATAL_ERROR "Expected one applied reinitialization reset: ${ROOT}, got ${RESET_COUNT}")
        endif()
        set(EXPECTED_TIME 30300000)
        set(EXPECTED_REASON source_changed)
        if(CASE STREQUAL "reference_unaided")
            set(EXPECTED_TIME 30000000)
            set(EXPECTED_REASON reference_changed)
        elseif(CASE STREQUAL "source_disturbed")
            set(EXPECTED_TIME 41000000)
        endif()
        list(GET RESETS 0 RESET_ROW)
        if(NOT RESET_ROW MATCHES "^${EXPECTED_TIME},${EXPECTED_TIME},0," OR NOT RESET_ROW MATCHES ",${EXPECTED_REASON}$")
            message(FATAL_ERROR "Wrong reinitialization time/reason: ${ROOT}: ${RESET_ROW}")
        endif()
        set(RESUMED FALSE)
        foreach(ROW IN LISTS FUSED)
            string(REGEX MATCH "^[0-9]+" FUSED_TIME "${ROW}")
            if(FUSED_TIME GREATER EXPECTED_TIME)
                set(RESUMED TRUE)
            endif()
        endforeach()
        if(NOT RESUMED)
            message(FATAL_ERROR "Real correction did not resume after source/reference reset: ${ROOT}")
        endif()
        # Applied navigation-yaw delta should be a quarter turn, with no tilt component.
        string(REPLACE "," ";" RESET_FIELDS "${RESET_ROW}")
        list(GET RESET_FIELDS 3 Q0)
        list(GET RESET_FIELDS 4 Q1)
        list(GET RESET_FIELDS 5 Q2)
        list(GET RESET_FIELDS 6 Q3)
        if(Q0 LESS 0.69 OR Q0 GREATER 0.72 OR Q1 LESS -0.00001 OR Q1 GREATER 0.00001 OR
           Q2 LESS -0.00001 OR Q2 GREATER 0.00001)
            message(FATAL_ERROR "Reinitialization did not apply the expected tilt-preserving yaw delta: ${ROOT}")
        endif()
        if(CASE STREQUAL "reference_unaided")
            if(Q3 LESS 0.69 OR Q3 GREATER 0.72)
                message(FATAL_ERROR "New eastward reference must rotate yaw positively: ${ROOT}")
            endif()
        elseif(Q3 GREATER -0.69 OR Q3 LESS -0.72)
            message(FATAL_ERROR "New eastward measurement must rotate yaw negatively: ${ROOT}")
        endif()
    endif()
    message(STATUS "Magnetic reinitialization ${CASE}: pass (${ROOT})")
    return()
endif()
if(CASE STREQUAL "aided")
    file(STRINGS "${OUTPUT}/magnetometer_updates.csv" STOPS REGEX ",heading_inconsistent,none,")
    if(NOT RESET_COUNT EQUAL 0 OR NOT STOPS)
        message(FATAL_ERROR "Inconsistent aided heading must inhibit navigation fusion without resetting yaw: ${ROOT}")
    endif()
else()
    if(NOT RESET_COUNT EQUAL 1)
        message(FATAL_ERROR "Expected one applied heading reset, got ${RESET_COUNT}: ${ROOT}")
    endif()
    list(GET RESETS 0 RESET_ROW)
    string(REPLACE "," ";" FIELDS "${RESET_ROW}")
    list(GET FIELDS 0 RESET_TIME)
    list(GET FIELDS 2 STATUS)
    if(NOT STATUS EQUAL 0 OR RESET_TIME LESS_EQUAL 36900000)
        message(FATAL_ERROR "Reset must succeed strictly after 7 s without fusion: ${ROOT}")
    endif()
    if(CASE STREQUAL "disturbed" AND RESET_TIME LESS_EQUAL 40900000)
        message(FATAL_ERROR "Bad field must requalify >1 s health before reset: ${ROOT}")
    endif()
    file(STRINGS "${OUTPUT}/magnetometer_updates.csv" RESET_EVENTS REGEX "^${RESET_TIME},${RESET_TIME},reset,0,")
    if(NOT RESET_EVENTS)
        message(FATAL_ERROR "Applied reset must be visible as reset, not fused: ${ROOT}")
    endif()
    list(GET RESET_EVENTS 0 RESET_EVENT)
    if(NOT RESET_EVENT MATCHES ",29900000,${RESET_TIME},")
        message(FATAL_ERROR "Reset must retain last actual fusion and record separate reset time: ${ROOT}")
    endif()
    set(RESUMED FALSE)
    foreach(ROW IN LISTS FUSED)
        string(REGEX MATCH "^[0-9]+" FUSED_TIME "${ROW}")
        if(FUSED_TIME GREATER RESET_TIME)
            set(RESUMED TRUE)
        endif()
    endforeach()
    if(NOT RESUMED)
        message(FATAL_ERROR "Real magnetic correction must resume after heading reset: ${ROOT}")
    endif()
endif()
message(STATUS "Magnetic recovery ${CASE}: pass (${ROOT})")

# Exercise the real replay: cached innovations, IMU cadence and next-tick bias inhibition.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef RUN_ID)
set(ROOT "${OUTPUT_DIR}/replay-vertical-${CASE}-${RUN_ID}")
set(INPUT "${ROOT}/input")
set(OUTPUT "${ROOT}/result")
file(MAKE_DIRECTORY "${INPUT}")
file(WRITE "${INPUT}/initial.csv"
    "timestamp_us,q0,q1,q2,q3,vn,ve,vd,eph,epv,speed_accuracy\n1000000,1,0,0,0,0,0,0,1,1,0.2\n")
file(WRITE "${INPUT}/gnss_parameters.csv"
    "position_gate,velocity_gate,position_noise,velocity_noise,position_noise_limit\n5,5,0.5,0.3,10\n")
file(WRITE "${INPUT}/gnss_quality_parameters.csv"
    "check_mask,minimum_satellites,maximum_pdop,maximum_horizontal_accuracy,maximum_vertical_accuracy,maximum_speed_accuracy,maximum_horizontal_drift,maximum_vertical_drift,minimum_health_time_us\n0,6,2.5,3,5,0.5,0.1,0.2,2000000\n")
file(WRITE "${INPUT}/imu.csv" "timestamp_us,integral_dt_us,fx,fy,fz,wx,wy,wz\n")
file(WRITE "${INPUT}/imu_flags.csv" "timestamp_us,at_rest,accelerometer_clipping\n")
set(END_TIME 11000000)
set(EXPECTED_COUNT 1000)
if(CASE STREQUAL "outage")
    set(END_TIME 16000000)
    set(EXPECTED_COUNT 1500)
endif()
foreach(TIME RANGE 1000000 ${END_TIME} 10000)
    set(PERIOD 10000)
    set(CLIPPING 0)
    if(TIME GREATER_EQUAL 5000000 AND TIME LESS 5600000)
        set(CLIPPING 4)
    endif()
    if(CASE STREQUAL "clear")
        set(CLIPPING 0)
    elseif(CASE STREQUAL "missing" OR ((CASE STREQUAL "metadata_gap" OR CASE STREQUAL "reset_metadata_gap") AND TIME EQUAL 5550000))
        set(CLIPPING -1)
    elseif((CASE STREQUAL "gap" OR CASE STREQUAL "reset_gap") AND TIME EQUAL 5550000)
        set(PERIOD 5000)
    elseif((CASE STREQUAL "height" OR CASE STREQUAL "activation" OR CASE STREQUAL "reset_gap" OR CASE STREQUAL "reset_metadata_gap" OR CASE STREQUAL "reset_quality") AND TIME GREATER_EQUAL 4000000 AND TIME LESS 5600000)
        set(CLIPPING 4)
    endif()
    if(CASE STREQUAL "reset_quality" AND TIME GREATER_EQUAL 4000000 AND TIME LESS 7400000)
        set(CLIPPING 4)
    endif()
    file(APPEND "${INPUT}/imu.csv" "${TIME},${PERIOD},0.2,-0.1,-9.70665,0.005,0.003,0.01\n")
    file(APPEND "${INPUT}/imu_flags.csv" "${TIME},1,${CLIPPING}\n")
endforeach()
file(WRITE "${INPUT}/navigation.csv" "timestamp_us,pn,pe,pd,vn,ve,vd,eph,epv,speed_accuracy\n")
file(WRITE "${INPUT}/gnss_quality.csv"
    "timestamp_us,fix_type,satellites,pdop,spoofed,vel_ned_valid,in_air,at_rest,vn,ve,vd,dn,de,dd,reference_timestamp_us\n")
foreach(TIME RANGE 1200000 ${END_TIME} 200000)
    if(CASE STREQUAL "outage" AND TIME GREATER_EQUAL 5800000 AND TIME LESS 13600000)
        continue()
    endif()
    set(HEIGHT 0)
    set(VELOCITY 0)
    set(HORIZONTAL_VELOCITY 0)
    set(SPEED_ACCURACY 0.2)
    if(CASE STREQUAL "speed_accuracy")
        set(SPEED_ACCURACY 0.5) # Equality must block the exception, even with the quality bit disabled.
    endif()
    set(FIX 3)
    if(TIME GREATER_EQUAL 5000000 AND TIME LESS 5800000)
        set(VELOCITY -20)
        if(CASE STREQUAL "negative")
            set(VELOCITY 20)
        elseif(CASE STREQUAL "height")
            set(VELOCITY 0)
            set(HEIGHT -20)
        elseif(CASE STREQUAL "clear")
            set(HEIGHT -20) # Two GNSS axes still form only one reference family.
        elseif(CASE STREQUAL "horizontal")
            set(HORIZONTAL_VELOCITY 20)
        elseif(CASE STREQUAL "activation" OR CASE STREQUAL "reset_gap" OR CASE STREQUAL "reset_metadata_gap")
            set(HEIGHT -20)
        elseif(CASE STREQUAL "quality")
            set(FIX 2) # Velocity lifecycle survives this brief quality rejection.
        endif()
    endif()
    if(CASE STREQUAL "reset_quality" AND TIME GREATER_EQUAL 5000000 AND TIME LESS 7400000)
        set(VELOCITY -20)
        set(HEIGHT -20)
        if(TIME GREATER_EQUAL 5200000 AND TIME LESS_EQUAL 6000000)
            set(FIX 2)
        endif()
    endif()
    if(CASE STREQUAL "batch" AND TIME EQUAL 5000000)
        foreach(EXTRA IN ITEMS 4995000 4997000)
            file(APPEND "${INPUT}/navigation.csv" "${EXTRA},0,0,0,0,0,-20,1,1,0.2\n")
            file(APPEND "${INPUT}/gnss_quality.csv" "${EXTRA},3,10,1,0,1,1,-1,0,0,-20,0,0,0,0\n")
        endforeach()
    endif()
    file(APPEND "${INPUT}/navigation.csv" "${TIME},0,0,${HEIGHT},${HORIZONTAL_VELOCITY},0,${VELOCITY},1,1,${SPEED_ACCURACY}\n")
    file(APPEND "${INPUT}/gnss_quality.csv" "${TIME},${FIX},10,1,0,1,1,-1,${HORIZONTAL_VELOCITY},0,${VELOCITY},0,0,0,0\n")
    if((CASE STREQUAL "gap" OR CASE STREQUAL "metadata_gap") AND TIME EQUAL 5400000)
        # Exercise a real correction before the interruption clears the fault.
        file(APPEND "${INPUT}/navigation.csv" "5510000,0,0,0,0,0,-20,1,1,0.2\n")
        file(APPEND "${INPUT}/gnss_quality.csv" "5510000,3,10,1,0,1,1,-1,0,0,-20,0,0,0,0\n")
    endif()
endforeach()
execute_process(COMMAND "${REPLAY}" "${INPUT}" "${OUTPUT}"
    RESULT_VARIABLE RESULT OUTPUT_QUIET ERROR_VARIABLE STDERR TIMEOUT 60)
if(NOT RESULT STREQUAL "0")
    message(FATAL_ERROR "Vertical health replay failed: ${RESULT}\n${STDERR}\n${ROOT}")
endif()

# Parse named columns so added diagnostics cannot silently change test meaning.
function(READ_FIELDS HEADER ROW PREFIX)
    string(REPLACE "," ";" NAMES "${HEADER}")
    string(REPLACE "," ";" VALUES "${ROW}")
    list(LENGTH NAMES COUNT)
    list(LENGTH VALUES VALUE_COUNT)
    if(NOT COUNT EQUAL VALUE_COUNT)
        message(FATAL_ERROR "CSV column count mismatch: ${ROW}")
    endif()
    math(EXPR LAST "${COUNT} - 1")
    foreach(INDEX RANGE 0 ${LAST})
        list(GET NAMES ${INDEX} NAME)
        string(TOUPPER "${NAME}" NAME)
        list(GET VALUES ${INDEX} VALUE)
        set(${PREFIX}_${NAME} "${VALUE}" PARENT_SCOPE)
    endforeach()
endfunction()
file(STRINGS "${OUTPUT}/vertical_acceleration_health.csv" HEALTH)
file(STRINGS "${OUTPUT}/bias_learning.csv" BIAS)
file(STRINGS "${OUTPUT}/state.csv" STATES)
list(POP_FRONT HEALTH HEALTH_HEADER)
list(POP_FRONT BIAS BIAS_HEADER)
list(POP_FRONT STATES STATE_HEADER INITIAL_STATE)
READ_FIELDS("${STATE_HEADER}" "${INITIAL_STATE}" PREVIOUS_STATE)
list(LENGTH HEALTH COUNT)
list(LENGTH BIAS BIAS_COUNT)
list(LENGTH STATES STATE_COUNT)
if(NOT COUNT EQUAL EXPECTED_COUNT OR NOT BIAS_COUNT EQUAL COUNT OR NOT STATE_COUNT EQUAL COUNT)
    message(FATAL_ERROR "Expected one verdict and permission row per real IMU tick: ${ROOT}")
endif()
set(PREVIOUS_AVAILABLE 0)
set(PREVIOUS_FAULT 0)
set(PREVIOUS_GOOD 0)
set(FIRST_FAULT 0)
set(HELD_COUNT 0)
set(INHIBITED_COUNT 0)
set(EVALUATED_COUNT 0)
set(OVERRIDDEN_X 0)
set(OVERRIDDEN_Y 0)
set(OVERRIDDEN_Z 0)
set(NOISE_UNAVAILABLE 0)
set(LEARNED_AFTER_RECOVERY FALSE)
set(GYRO_LEARNED_DURING_FAULT FALSE)
math(EXPR LAST_INDEX "${COUNT} - 1")
foreach(INDEX RANGE 0 ${LAST_INDEX})
    list(GET HEALTH ${INDEX} ROW)
    READ_FIELDS("${HEALTH_HEADER}" "${ROW}" H)
    list(GET BIAS ${INDEX} ROW)
    READ_FIELDS("${BIAS_HEADER}" "${ROW}" B)
    list(GET STATES ${INDEX} ROW)
    READ_FIELDS("${STATE_HEADER}" "${ROW}" S)
    if(NOT H_TIMESTAMP_US EQUAL B_TIMESTAMP_US OR NOT H_TIMESTAMP_US EQUAL S_TIMESTAMP_US)
        message(FATAL_ERROR "Unaligned diagnostic rows: ${ROOT}")
    endif()
    if(B_ACCELEROMETER_CLIPPING EQUAL -1 OR ((CASE STREQUAL "gap" OR CASE STREQUAL "reset_gap") AND H_TIMESTAMP_US EQUAL 5550000))
        set(PREVIOUS_AVAILABLE 0)
        set(PREVIOUS_FAULT 0)
        set(PREVIOUS_GOOD 0)
    endif()
    if(NOT B_VERTICAL_ACCELERATION_AVAILABLE EQUAL PREVIOUS_AVAILABLE OR
       NOT B_BAD_VERTICAL_ACCELERATION EQUAL PREVIOUS_FAULT)
        message(FATAL_ERROR "Bias must consume the preceding valid verdict at ${H_TIMESTAMP_US}: ${ROOT}")
    endif()
    if(B_ACCELEROMETER_CLIPPING LESS 0)
        math(EXPR NOISE_UNAVAILABLE "${NOISE_UNAVAILABLE} + 1")
    endif()
    set(AXIS_INDEX 0)
    foreach(AXIS IN ITEMS X Y Z)
        set(EXPECTED_VARIANCE 1)
        if(B_ACCELEROMETER_CLIPPING GREATER_EQUAL 0)
            math(EXPR CLIPPED "${B_ACCELEROMETER_CLIPPING} & (1 << ${AXIS_INDEX})")
            if(B_BAD_VERTICAL_ACCELERATION OR CLIPPED)
                set(EXPECTED_VARIANCE 24.01)
                math(EXPR OVERRIDDEN_${AXIS} "${OVERRIDDEN_${AXIS}} + 1")
            endif()
        endif()
        if(EXPECTED_VARIANCE EQUAL 1)
            if(NOT B_ACCEL_VARIANCE_${AXIS} EQUAL 1)
                message(FATAL_ERROR "Unaffected/unknown axis must retain configured variance: ${ROOT}")
            endif()
        elseif(B_ACCEL_VARIANCE_${AXIS} LESS 24.009999 OR B_ACCEL_VARIANCE_${AXIS} GREATER 24.010001)
            message(FATAL_ERROR "Fault/clipping must select squared 4.9 m/s^2 on body ${AXIS}: ${ROOT}")
        endif()
        math(EXPR AXIS_INDEX "${AXIS_INDEX} + 1")
    endforeach()
    if(NOT B_BGX_ENABLED OR NOT B_BGY_ENABLED OR NOT B_BGZ_ENABLED)
        message(FATAL_ERROR "Vertical fault must not inhibit gyro learning: ${ROOT}")
    endif()
    if(B_BAD_VERTICAL_ACCELERATION)
        math(EXPR INHIBITED_COUNT "${INHIBITED_COUNT} + 1")
        if(B_BAX_ENABLED OR B_BAY_ENABLED OR B_BAZ_ENABLED)
            message(FATAL_ERROR "Vertical fault must inhibit all accel axes: ${ROOT}")
        endif()
        foreach(AXIS IN ITEMS BAX BAY BAZ)
            if(NOT S_${AXIS} STREQUAL PREVIOUS_STATE_${AXIS})
                message(FATAL_ERROR "Actual correction changed inhibited ${AXIS} at ${H_TIMESTAMP_US}: ${ROOT}")
            endif()
        endforeach()
        if(NOT S_BGX STREQUAL PREVIOUS_STATE_BGX OR NOT S_BGY STREQUAL PREVIOUS_STATE_BGY OR
           NOT S_BGZ STREQUAL PREVIOUS_STATE_BGZ)
            set(GYRO_LEARNED_DURING_FAULT TRUE)
        endif()
    elseif(FIRST_FAULT GREATER 0 AND B_BAX_ENABLED AND NOT S_BAX STREQUAL PREVIOUS_STATE_BAX)
        set(LEARNED_AFTER_RECOVERY TRUE)
    endif()
    if(H_LIKELIHOOD GREATER 1)
        message(FATAL_ERROR "GNSS-only observations cannot establish high likelihood: ${ROOT}")
    endif()
    if(H_AVAILABLE)
        math(EXPR EVALUATED_COUNT "${EVALUATED_COUNT} + 1")
    endif()
    if(H_BAD_VERTICAL_ACCELERATION)
        math(EXPR HELD_COUNT "${HELD_COUNT} + 1")
        if(FIRST_FAULT EQUAL 0)
            set(FIRST_FAULT ${H_TIMESTAMP_US})
        endif()
    endif()
    if(H_LAST_BAD_TIMESTAMP_US GREATER 0)
        math(EXPR AGE "${H_TIMESTAMP_US} - ${H_LAST_BAD_TIMESTAMP_US}")
        if((AGE LESS 3000000 AND NOT H_BAD_VERTICAL_ACCELERATION) OR
           (AGE GREATER_EQUAL 3000000 AND H_BAD_VERTICAL_ACCELERATION))
            message(FATAL_ERROR "Fault hold must end at exactly 3 s: ${ROOT}")
        endif()
    endif()
    if(H_TIMESTAMP_US EQUAL 5000000 AND NOT CASE STREQUAL "missing")
        set(EXPECTED_HEIGHT_TIME 4800000)
        if(CASE STREQUAL "batch")
            set(EXPECTED_HEIGHT_TIME 4997000)
            if(NOT H_CLIP_COUNT_Z EQUAL 1)
                message(FATAL_ERROR "Multiple GNSS events must not count clipping multiple times: ${ROOT}")
            endif()
        endif()
        if(NOT H_VELOCITY_SOURCE_TIMESTAMP_US EQUAL 5000000 OR NOT H_HEIGHT_SOURCE_TIMESTAMP_US EQUAL EXPECTED_HEIGHT_TIME)
            message(FATAL_ERROR "Use current velocity and preceding height diagnostics: ${ROOT}")
        endif()
    endif()
    if(H_TIMESTAMP_US EQUAL 5010000 AND NOT CASE STREQUAL "missing" AND NOT CASE STREQUAL "quality")
        if(NOT H_HEIGHT_SOURCE_TIMESTAMP_US EQUAL 5000000 OR NOT H_VELOCITY_SOURCE_TIMESTAMP_US EQUAL 5000000)
            message(FATAL_ERROR "Retain aiding diagnostics between GNSS events: ${ROOT}")
        endif()
    endif()
    if(CASE STREQUAL "outage")
        if(H_TIMESTAMP_US GREATER_EQUAL 6610000 AND H_TIMESTAMP_US LESS 13600000 AND H_HEIGHT_ACTIVE)
            message(FATAL_ERROR "Stopped height source must not contribute cached evidence: ${ROOT}")
        endif()
        if(H_TIMESTAMP_US GREATER_EQUAL 12600000 AND H_TIMESTAMP_US LESS 13600000 AND H_VELOCITY_ACTIVE)
            message(FATAL_ERROR "Stopped velocity source must not contribute cached evidence: ${ROOT}")
        endif()
    endif()
    if((CASE STREQUAL "gap" OR CASE STREQUAL "reset_gap") AND H_TIMESTAMP_US EQUAL 5550000)
        if(NOT H_CLIP_COUNT_Z EQUAL 1 OR H_LAST_BAD_TIMESTAMP_US GREATER 0 OR
           H_AVERAGE_INTERVAL_S LESS 0.009949999 OR H_AVERAGE_INTERVAL_S GREATER 0.009950001)
            message(FATAL_ERROR "Gap hold must not count as a real sample; restart averaged interval: ${ROOT}")
        endif()
    endif()
    set(PRIOR_AVAILABLE_${H_TIMESTAMP_US} ${B_VERTICAL_ACCELERATION_AVAILABLE})
    set(PRIOR_GOOD_${H_TIMESTAMP_US} ${PREVIOUS_GOOD})
    set(CURRENT_AVAILABLE_${H_TIMESTAMP_US} ${H_AVAILABLE})
    set(CURRENT_GOOD_${H_TIMESTAMP_US} ${H_LAST_GOOD_TIMESTAMP_US})
    set(STATE_PD_${H_TIMESTAMP_US} ${S_PD})
    set(STATE_VD_${H_TIMESTAMP_US} ${S_VD})
    set(STATE_P2_${H_TIMESTAMP_US} ${S_P2})
    set(STATE_P5_${H_TIMESTAMP_US} ${S_P5})
    set(PREVIOUS_GOOD ${H_LAST_GOOD_TIMESTAMP_US})
    set(PRIOR_FAULT_${H_TIMESTAMP_US} ${B_BAD_VERTICAL_ACCELERATION})
    set(CURRENT_FAULT_${H_TIMESTAMP_US} ${H_BAD_VERTICAL_ACCELERATION})
    set(PREVIOUS_AVAILABLE ${H_AVAILABLE})
    set(PREVIOUS_FAULT ${H_BAD_VERTICAL_ACCELERATION})
    foreach(AXIS IN ITEMS BAX BAY BAZ BGX BGY BGZ)
        set(PREVIOUS_STATE_${AXIS} "${S_${AXIS}}")
    endforeach()
endforeach()
if(CASE STREQUAL "clear" OR CASE STREQUAL "negative" OR CASE STREQUAL "missing")
    if(NOT FIRST_FAULT EQUAL 0 OR NOT INHIBITED_COUNT EQUAL 0)
        message(FATAL_ERROR "This input must not trigger a vertical fault: ${ROOT}")
    endif()
else()
    set(EXPECTED_FIRST 5490000)
    if(CASE STREQUAL "height")
        set(EXPECTED_FIRST 5010000)
    elseif(CASE STREQUAL "activation" OR CASE STREQUAL "reset_gap" OR CASE STREQUAL "reset_metadata_gap" OR CASE STREQUAL "reset_quality")
        set(EXPECTED_FIRST 5000000)
    endif()
    if(NOT FIRST_FAULT EQUAL EXPECTED_FIRST OR INHIBITED_COUNT EQUAL 0)
        message(FATAL_ERROR "Expected fault at ${EXPECTED_FIRST}, actual ${FIRST_FAULT}, with next-tick inhibition: ${ROOT}")
    endif()
    if(NOT LEARNED_AFTER_RECOVERY OR NOT GYRO_LEARNED_DURING_FAULT)
        message(FATAL_ERROR "Actual corrections must demonstrate accel recovery (${LEARNED_AFTER_RECOVERY}) and unaffected gyro learning (${GYRO_LEARNED_DURING_FAULT}): ${ROOT}")
    endif()
endif()
if(CASE STREQUAL "missing" AND NOT EVALUATED_COUNT EQUAL 0)
    message(FATAL_ERROR "Unknown clipping cannot be evaluated: ${ROOT}")
endif()
if(CASE STREQUAL "fault")
    file(STRINGS "${OUTPUT}/gnss_updates.csv" REJECTIONS REGEX "^5[0-9]+,[0-9]+,velocity,2,rejected,")
    if(NOT REJECTIONS)
        message(FATAL_ERROR "Fault must be demonstrated with actual gate-rejected diagnostics: ${ROOT}")
    endif()
elseif(CASE STREQUAL "quality")
    file(STRINGS "${OUTPUT}/gnss_updates.csv" ATTEMPTS REGEX "^5[0246]00000,")
    if(ATTEMPTS)
        message(FATAL_ERROR "Quality-rejected evidence must not invoke correction: ${ROOT}")
    endif()
endif()
file(READ "${OUTPUT}/summary.json" SUMMARY)
string(JSON RECORDED GET "${SUMMARY}" vertical_acceleration_fault_samples)
string(JSON INHIBITED GET "${SUMMARY}" vertical_acceleration_bias_inhibited_samples)
string(JSON EVALUATED GET "${SUMMARY}" vertical_acceleration_evaluated_samples)
if(NOT RECORDED EQUAL HELD_COUNT OR NOT INHIBITED EQUAL INHIBITED_COUNT OR NOT EVALUATED EQUAL EVALUATED_COUNT)
    message(FATAL_ERROR "Summary must agree with per-tick evidence: ${ROOT}")
endif()
if(CASE STREQUAL "gap" OR CASE STREQUAL "reset_gap")
    math(EXPR NOISE_UNAVAILABLE "${NOISE_UNAVAILABLE} + 1") # Synthetic hold has no clipping measurement.
endif()
string(JSON RECORDED_UNAVAILABLE GET "${SUMMARY}" accelerometer_noise_unavailable_predictions)
string(JSON FAULT_STD GET "${SUMMARY}" accelerometer_fault_noise_std)
if(NOT RECORDED_UNAVAILABLE EQUAL NOISE_UNAVAILABLE OR NOT FAULT_STD EQUAL 4.9)
    message(FATAL_ERROR "Missing metadata/gap holds and the selected fault STD must be explicit: ${ROOT}")
endif()
set(AXIS_INDEX 0)
foreach(AXIS IN ITEMS X Y Z)
    string(JSON RECORDED_OVERRIDE GET "${SUMMARY}" accelerometer_noise_overridden_predictions ${AXIS_INDEX})
    if(NOT RECORDED_OVERRIDE EQUAL OVERRIDDEN_${AXIS})
        message(FATAL_ERROR "Noise override counts must match actual prediction selections: ${ROOT}")
    endif()
    math(EXPR AXIS_INDEX "${AXIS_INDEX} + 1")
endforeach()
# Validate actual gate-to-correction behavior, not just detection/counters.
file(STRINGS "${OUTPUT}/gnss_updates.csv" GNSS_ROWS)
list(POP_FRONT GNSS_ROWS GNSS_HEADER)
set(VELOCITY_LIMITED 0)
set(HEIGHT_LIMITED 0)
foreach(ROW IN LISTS GNSS_ROWS)
    READ_FIELDS("${GNSS_HEADER}" "${ROW}" G)
    if(G_GROUP STREQUAL "velocity" AND G_AXIS EQUAL 0)
        set(NORTH_RATIO "${G_TEST_RATIO}")
    elseif(G_GROUP STREQUAL "velocity" AND G_AXIS EQUAL 1)
        set(EAST_RATIO "${G_TEST_RATIO}")
    endif()
    if(G_GROUP STREQUAL "horizontal_position" OR (G_GROUP STREQUAL "velocity" AND G_AXIS LESS 2))
        if(NOT G_INNOVATION STREQUAL G_FUSION_INNOVATION)
            message(FATAL_ERROR "Exception must not change horizontal residuals: ${ROOT}")
        endif()
    endif()
    if(G_GROUP STREQUAL "horizontal_position" AND G_INNOVATION_LIMITED)
        message(FATAL_ERROR "Horizontal position has no exception: ${ROOT}")
    endif()
    if(G_INNOVATION_LIMITED AND (G_GROUP STREQUAL "vertical_position" OR G_AXIS EQUAL 2))
        if(NOT G_OUTCOME STREQUAL "fused" OR NOT G_DIAGNOSTICS_VALID OR NOT G_TEST_RATIO GREATER 1)
            message(FATAL_ERROR "Limited fusion must retain original rejected gate evidence: ${ROOT}")
        endif()
        if((G_INNOVATION LESS 0 AND (NOT G_FUSION_INNOVATION LESS 0 OR NOT G_FUSION_INNOVATION GREATER G_INNOVATION)) OR
           (G_INNOVATION GREATER 0 AND (NOT G_FUSION_INNOVATION GREATER 0 OR NOT G_FUSION_INNOVATION LESS G_INNOVATION)))
            message(FATAL_ERROR "Limited residual must retain its sign and reduce magnitude: ${ROOT}")
        endif()
        if(G_GROUP STREQUAL "velocity")
            if(NOT PRIOR_FAULT_${G_FUSION_TIMESTAMP_US} OR NOT NORTH_RATIO LESS 1 OR NOT EAST_RATIO LESS 1)
                message(FATAL_ERROR "Velocity exception needs preceding fault and strictly passing horizontal axes: ${ROOT}")
            endif()
            math(EXPR VELOCITY_LIMITED "${VELOCITY_LIMITED} + 1")
        else()
            if(NOT CURRENT_FAULT_${G_FUSION_TIMESTAMP_US} AND NOT CASE STREQUAL "batch")
                message(FATAL_ERROR "Height must consume current pre-height verdict: ${ROOT}")
            endif()
            math(EXPR HEIGHT_LIMITED "${HEIGHT_LIMITED} + 1")
        endif()
    elseif(NOT G_INNOVATION_LIMITED AND NOT G_INNOVATION STREQUAL G_FUSION_INNOVATION)
        message(FATAL_ERROR "Unselected residual must remain unchanged: ${ROOT}")
    endif()
    if(CASE STREQUAL "activation" AND G_SOURCE_TIMESTAMP_US EQUAL 5000000)
        if(G_GROUP STREQUAL "velocity" AND (NOT G_OUTCOME STREQUAL "rejected" OR G_INNOVATION_LIMITED))
            message(FATAL_ERROR "New fault must not retroactively release velocity: ${ROOT}")
        elseif(G_GROUP STREQUAL "vertical_position" AND (NOT G_OUTCOME STREQUAL "fused" OR NOT G_INNOVATION_LIMITED))
            message(FATAL_ERROR "New fault must release height at this same horizon: ${ROOT}")
        endif()
    endif()
endforeach()
if((CASE STREQUAL "fault" OR CASE STREQUAL "activation") AND VELOCITY_LIMITED EQUAL 0)
    message(FATAL_ERROR "Fault case must exercise actual limited velocity fusion: ${ROOT}")
endif()
if((CASE STREQUAL "height" OR CASE STREQUAL "activation") AND HEIGHT_LIMITED EQUAL 0)
    message(FATAL_ERROR "Height fault case must exercise actual limited height fusion: ${ROOT}")
endif()
if((CASE STREQUAL "horizontal" OR CASE STREQUAL "speed_accuracy") AND NOT VELOCITY_LIMITED EQUAL 0)
    message(FATAL_ERROR "Horizontal rejection or equal accuracy bound must block velocity exception: ${ROOT}")
endif()
if((CASE STREQUAL "missing" OR CASE STREQUAL "negative" OR CASE STREQUAL "clear") AND
   (NOT VELOCITY_LIMITED EQUAL 0 OR NOT HEIGHT_LIMITED EQUAL 0))
    message(FATAL_ERROR "Without fault evidence no exception is permitted: ${ROOT}")
endif()
string(JSON RECORDED_VELOCITY GET "${SUMMARY}" gnss_velocity_limited_fusions)
string(JSON RECORDED_HEIGHT GET "${SUMMARY}" gnss_height_limited_fusions)
if(NOT RECORDED_VELOCITY EQUAL VELOCITY_LIMITED OR NOT RECORDED_HEIGHT EQUAL HEIGHT_LIMITED)
    message(FATAL_ERROR "Summary must count successful limited fusions: ${ROOT}")
endif()
file(STRINGS "${OUTPUT}/gnss_quality.csv" QUALITY_ROWS)
list(POP_FRONT QUALITY_ROWS QUALITY_HEADER)
foreach(ROW IN LISTS QUALITY_ROWS)
    READ_FIELDS("${QUALITY_HEADER}" "${ROW}" Q)
    set(QUALITY_${Q_SOURCE_TIMESTAMP_US} "${Q_OUTCOME}")
endforeach()
file(STRINGS "${OUTPUT}/gnss_resets.csv" RESET_ROWS)
list(POP_FRONT RESET_ROWS RESET_HEADER)
set(VELOCITY_RESETS 0)
set(HEIGHT_RESETS 0)
set(FIRST_ACCEL_RESET 0)
foreach(ROW IN LISTS RESET_ROWS)
    READ_FIELDS("${RESET_HEADER}" "${ROW}" R)
    if(NOT R_REASON STREQUAL "bad_vertical_acceleration")
        continue()
    endif()
    if(NOT QUALITY_${R_SOURCE_TIMESTAMP_US} STREQUAL "accepted" OR NOT R_OUTCOME STREQUAL "reset" OR NOT R_DELTA_VALID)
        message(FATAL_ERROR "Acceleration recovery requires a real qualified reset: ${ROOT}")
    endif()
    if(FIRST_ACCEL_RESET EQUAL 0)
        set(FIRST_ACCEL_RESET ${R_FUSION_TIMESTAMP_US})
    endif()
    if(R_GROUP STREQUAL "vertical_velocity")
        set(AVAILABLE ${PRIOR_AVAILABLE_${R_FUSION_TIMESTAMP_US}})
        set(LAST_GOOD ${PRIOR_GOOD_${R_FUSION_TIMESTAMP_US}})
        if(HEIGHT_RESET_${R_SOURCE_TIMESTAMP_US})
            message(FATAL_ERROR "Down reset must precede height reset for this sample: ${ROOT}")
        endif()
        math(EXPR VELOCITY_RESETS "${VELOCITY_RESETS} + 1")
    elseif(R_GROUP STREQUAL "vertical_position")
        set(AVAILABLE ${CURRENT_AVAILABLE_${R_FUSION_TIMESTAMP_US}})
        set(LAST_GOOD ${CURRENT_GOOD_${R_FUSION_TIMESTAMP_US}})
        set(HEIGHT_RESET_${R_SOURCE_TIMESTAMP_US} TRUE)
        math(EXPR HEIGHT_RESETS "${HEIGHT_RESETS} + 1")
        file(STRINGS "${OUTPUT}/gnss_updates.csv" CORRECTION REGEX "^${R_SOURCE_TIMESTAMP_US},${R_FUSION_TIMESTAMP_US},vertical_position,0,fused,")
        if(NOT CORRECTION)
            message(FATAL_ERROR "Fixture must show reset after successful height correction: ${ROOT}")
        endif()
        if(NOT STATE_PD_${R_FUSION_TIMESTAMP_US} EQUAL -20 OR NOT STATE_P2_${R_FUSION_TIMESTAMP_US} EQUAL 1)
            message(FATAL_ERROR "Actual height reset must install GNSS Down position and observation variance: ${ROOT}")
        endif()
        set(EXPECTED_VD -20)
        if(CASE STREQUAL "height")
            set(EXPECTED_VD 0)
        endif()
        if(NOT STATE_VD_${R_FUSION_TIMESTAMP_US} EQUAL EXPECTED_VD OR
           STATE_P5_${R_FUSION_TIMESTAMP_US} LESS 0.20249999 OR STATE_P5_${R_FUSION_TIMESTAMP_US} GREATER 0.20250001)
            message(FATAL_ERROR "Down velocity reset and its variance must survive subsequent height processing: ${ROOT}")
        endif()
    else()
        message(FATAL_ERROR "Acceleration recovery must not reset horizontal groups: ${ROOT}")
    endif()
    math(EXPR AGE "${R_FUSION_TIMESTAMP_US} - ${LAST_GOOD}")
    if(NOT AVAILABLE OR (LAST_GOOD GREATER 0 AND NOT AGE GREATER 500000))
        message(FATAL_ERROR "Reset requires known health and strictly more than 500 ms since last good: ${ROOT}")
    endif()
endforeach()
if(CASE STREQUAL "height" OR CASE STREQUAL "activation" OR CASE STREQUAL "reset_quality")
    set(EXPECTED_RESET_TIME 5600000)
    if(CASE STREQUAL "reset_quality")
        set(EXPECTED_RESET_TIME 7200000)
    endif()
    if(NOT FIRST_ACCEL_RESET EQUAL EXPECTED_RESET_TIME OR VELOCITY_RESETS EQUAL 0 OR HEIGHT_RESETS EQUAL 0)
        message(FATAL_ERROR "Expected velocity/height recovery at ${EXPECTED_RESET_TIME}, actual ${FIRST_ACCEL_RESET}: ${ROOT}")
    endif()
elseif(NOT VELOCITY_RESETS EQUAL 0 OR NOT HEIGHT_RESETS EQUAL 0)
    message(FATAL_ERROR "A held flag, missing data or short bad period must not trigger 500 ms recovery: ${ROOT}")
endif()
string(JSON RECORDED_VELOCITY_RESETS GET "${SUMMARY}" vertical_acceleration_velocity_resets)
string(JSON RECORDED_HEIGHT_RESETS GET "${SUMMARY}" vertical_acceleration_height_resets)
string(JSON DELAY GET "${SUMMARY}" vertical_acceleration_reset_delay_us)
if(NOT RECORDED_VELOCITY_RESETS EQUAL VELOCITY_RESETS OR NOT RECORDED_HEIGHT_RESETS EQUAL HEIGHT_RESETS OR NOT DELAY EQUAL 500000)
    message(FATAL_ERROR "Summary must distinguish acceleration recovery from other resets: ${ROOT}")
endif()
message(STATUS "Vertical health ${CASE}: ${HELD_COUNT} fault ticks, ${INHIBITED_COUNT} inhibited ticks (${ROOT})")
